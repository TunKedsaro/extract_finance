# Direct Terrax/Anthropic-compatible access. Leave blank when using LiteLLM.
ANTHROPIC_BASE_URL=https://gateway-dev.terrax.dev
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-5

# LiteLLM fallback used when ANTHROPIC_AUTH_TOKEN is blank.
LITELLM_PROXY_URL=http://litellm:4000
LITELLM_MASTER_KEY=

# Application behavior.
INPUT_DIR=resources/input
OUTPUT_DIR=outputs
SAVE_OUTPUT=true
MAX_INPUT_FILE_SIZE_BYTES=20971520
MAX_LLM_REQUEST_SIZE_BYTES=31457280
LOG_LEVEL=INFO
